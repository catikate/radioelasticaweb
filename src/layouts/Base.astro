---
import '../styles/global.css'
import { ViewTransitions } from 'astro:transitions'
import Navbar     from '@/components/layout/Navbar.astro'
import LivePlayer  from '@/components/player/LivePlayer'

interface Props {
  title?:       string
  description?: string
  ogImage?:     string
}

const {
  title       = 'Radio Elástica',
  description = 'Emisora online independiente desde Barcelona. Miércoles 11:11.',
  ogImage     = '/assets/logo-square.jpg',
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://radioelastica.com')
---

<!doctype html>
<html lang="es">
<head>
 <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="google-site-verification" content="vWaTl3dZboH6NjzwY1eJKFBkSrBDwfV5ci0zyY5m8d8" />
  <link rel="icon" type="image/jpeg" href="/assets/logo-square.jpg" />
  <link rel="canonical" href={canonicalURL} />

  <title>{title === 'Radio Elástica' ? title : `${title} — Radio Elástica`}</title>
  <meta name="description" content={description} />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={ogImage} />

  <!-- Twitter -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={ogImage} />

  <!-- Tipografía — Playfair Display -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet" />

  <ViewTransitions />
</head>

<body class="bg-re-blue text-white font-display">

  <!-- NAV — fijo en la parte superior -->
  <Navbar />

  <!-- CONTENIDO — zona con scroll entre nav y reproductor -->
  <main id="content" class="no-scrollbar">
    <slot />
  </main>

  <!-- BOTÓN HOME FLOTANTE — solo fuera de la home -->
 <!-- BOTÓN HOME FLOTANTE — Grande y Centrado a la derecha -->
<a
  id="home-fab"
  href="/"
  class="fixed z-50 top-1/2 right-10 -translate-y-1/2
         w-16 h-16 rounded-full bg-white/10 border border-white/20
         flex items-center justify-center
         hover:bg-white/20 transition-all transform hover:scale-110
         hidden"
  aria-label="Volver al inicio"
>
  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M19 12H5"/>
    <path d="M12 19l-7-7 7-7"/>
  </svg>
</a>

<!-- AUDIO EN VIVO — singleton persistente, controlado por liveAudio.ts -->
<audio id="live-audio" transition:persist></audio>

<!-- BANNER EN VIVO -->
<LivePlayer client:load transition:persist />

<!-- REPRODUCTOR — creado imperativament fuera de <body> para que el swap
     de Astro View Transitions nunca lo toque. Los iframes se reinician al
     salir del DOM; viviendo en <html> (no en <body>) nunca se desconectan.
     Hidden hasta el primer click en un episodio. -->
<script is:inline>
  (function () {
    if (document.getElementById('player-bar')) return;

    var bar = document.createElement('div');
    bar.id = 'player-bar';
    bar.style.cssText = [
      'position:fixed', 'bottom:0', 'left:0', 'right:0',
      'height:84px', 'z-index:50',
      'display:none', 'align-items:center',
      'background:#1a1a2e',
      'border-top:2px solid #3878F5',
    ].join(';');

    document.documentElement.appendChild(bar);
  })();
</script>

<!-- ARCHIVE PLAYER — error handling + preflight check -->
<script>
  import { $currentTrack } from '@/lib/store'
  import { widgetSrc } from '@/lib/mixcloud'
  import type { PlayerTrack } from '@/lib/types'

  let loadId = 0

  function escape(s: string) {
    return s.replace(/[&<>"']/g, c =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] ?? c)
    )
  }

  function getBar()    { return document.getElementById('player-bar') }
  function getIframe() { return document.getElementById('mc-widget') as HTMLIFrameElement | null }

  function showIframe(src: string) {
    const bar = getBar()
    if (!bar) return
    bar.style.display = 'flex'
    document.documentElement.style.setProperty('--player-h', '84px')
    document.getElementById('mc-fallback')?.remove()
    let iframe = getIframe()
    if (iframe) {
      iframe.style.display = 'block'
      iframe.src = src
    } else {
      iframe = document.createElement('iframe')
      iframe.id    = 'mc-widget'
      iframe.src   = src
      iframe.allow = 'autoplay'
      iframe.style.cssText = 'width:100%;height:62px;border:none;'
      bar.appendChild(iframe)
    }
  }

  function showFallback(track: PlayerTrack) {
    const bar    = getBar()
    const iframe = getIframe()
    if (!bar) return
    bar.style.display = 'flex'
    document.documentElement.style.setProperty('--player-h', '84px')
    if (iframe) iframe.style.display = 'none'
    document.getElementById('mc-fallback')?.remove()

    const div = document.createElement('div')
    div.id = 'mc-fallback'
    div.style.cssText = [
      'display:flex', 'align-items:center', 'gap:12px',
      'width:100%', 'padding:0 16px',
    ].join(';')
    div.innerHTML = `
      <img src="${escape(track.cover)}" alt=""
           style="height:44px;width:44px;object-fit:cover;border-radius:4px;flex-shrink:0" />
      <div style="flex:1;min-width:0;overflow:hidden">
        <p style="margin:0;font-size:13px;font-weight:bold;color:#fff;
                  white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
          ${escape(track.title)}</p>
        <p style="margin:2px 0 0;font-size:11px;color:rgba(255,255,255,0.5)">
          El reproductor no está disponible en este momento.</p>
      </div>
      <button id="mc-retry"
              style="flex-shrink:0;font-size:11px;color:#fff;cursor:pointer;white-space:nowrap;
                     background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.2);
                     padding:5px 12px;border-radius:4px">
        Reintentar
      </button>`
    bar.appendChild(div)

    document.getElementById('mc-retry')?.addEventListener('click', () => {
      const t = $currentTrack.get()
      if (t) loadTrack(t)
    })
  }

  async function loadTrack(track: PlayerTrack) {
    const myId = ++loadId
    try {
      const ctrl = new AbortController()
      const timer = setTimeout(() => ctrl.abort(), 5000)
      const res = await fetch(`https://api.mixcloud.com${track.key}`, { signal: ctrl.signal })
      clearTimeout(timer)
      if (loadId !== myId) return
      if (!res.ok) throw new Error(String(res.status))
      showIframe(widgetSrc(track.key, true))
    } catch {
      if (loadId !== myId) return
      showFallback(track)
    }
  }

  $currentTrack.subscribe(track => {
    if (!track) return
    loadTrack(track)
  })
</script>

  <!-- Swipe derecha para volver a home (móvil) + mostrar/ocultar FAB -->
  <script is:inline>
    (function() {
      // Mostrar/ocultar FAB según la ruta actual — se llama en cada navegación
      function setupFab() {
        var fab = document.getElementById('home-fab');
        if (!fab) return;
        if (window.location.pathname !== '/') {
          var path = window.location.pathname.replace(/\/$/, '');
          var parts = path.split('/').filter(Boolean);
          fab.href = '/';
          // /programas/slug → /programas, /residentes/slug → /residentes
          if (parts.length >= 2 && (parts[0] === 'programas' || parts[0] === 'residentes')) {
            fab.href = '/' + parts[0];
          }
          fab.classList.remove('hidden');
        } else {
          fab.classList.add('hidden');
        }
      }

      setupFab();
      document.addEventListener('astro:page-load', setupFab);

      // Swipe right → home — se inicializa una sola vez
      if (!window.__swipeInitialized) {
        window.__swipeInitialized = true;
        var startX = 0;
        var startY = 0;
        document.addEventListener('touchstart', function(e) {
          startX = e.touches[0].clientX;
          startY = e.touches[0].clientY;
        }, { passive: true });
        document.addEventListener('touchend', function(e) {
          var dx = e.changedTouches[0].clientX - startX;
          var dy = Math.abs(e.changedTouches[0].clientY - startY);
          if (dx > 100 && dy < 80 && startX < 40 && window.location.pathname !== '/') {
            var fab = document.getElementById('home-fab');
            window.location.href = fab ? fab.href : '/';
          }
        }, { passive: true });
      }
    })();
  </script>

</body>
</html>
