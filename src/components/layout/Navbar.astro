---
import { Image } from 'astro:assets'
import programas  from '@/assets/nav/programas.png'
import residentes from '@/assets/nav/residentes.png'
import calendario from '@/assets/nav/calendario.png'
import tienda     from '@/assets/nav/tienda.png'

const links = [
  { href: '/programas',  img: programas,  alt: 'Programas'  },
  { href: '/residentes', img: residentes, alt: 'Residentes' },
  { href: '/calendario', img: calendario, alt: 'Calendario' },
  { href: '/tienda',     img: tienda,     alt: 'Tienda'     },
]

// Se muestran a 56px de alto (h-14) como máximo → 1x, 2x y 3x de ese tamaño
const NAV_H = 56

const currentPath = Astro.url.pathname
---

<nav
  class="fixed top-10 left-0 right-0 z-50 h-nav
         bg-re-blue
         flex items-center justify-center gap-1.5 sm:gap-3 px-2 sm:px-4"
>
  {links.map(({ href, img, alt }) => (
    <a
      href={href}
      class:list={[
        'flex items-center justify-center h-12 px-4 rounded transition-opacity',
        currentPath.startsWith(href)
          ? 'opacity-100'
          : 'opacity-50 hover:opacity-80'
      ]}
    >
      <Image
        src={img}
        alt={alt}
        width={Math.round(NAV_H * img.width / img.height)}
        densities={[1, 2, 3]}
        class="h-9 sm:h-14 w-auto"
        loading="eager"
      />
    </a>
  ))}
</nav>
