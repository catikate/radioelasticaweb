---
import Base from '@/layouts/Base.astro'
import Foto from '@/components/Foto.astro'
import { PROGRAMAS } from '@/lib/constants'
import { fotoPrograma, IMG } from '@/lib/images'
---

<Base title="Programas">

  <section class="px-6 py-12">

    <h1 class="font-display italic text-3xl text-white text-center mb-2">
      ✦ Programas ✦
    </h1>

    <p class="text-white/50 text-xs uppercase tracking-[0.25em] text-center mb-12">
      Temporada 1
    </p>

    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4 max-w-4xl mx-auto">
      {PROGRAMAS.map((p, i) => (
        <a
          href={`/programas/${p.slug}`}
          class="block hover:scale-[1.02] transition-transform w-full"
        >
          <Foto
            src={fotoPrograma(p.slug)}
            alt={p.programa}
            class="w-full h-auto rounded-lg object-cover"
            widths={IMG.grid.widths}
            sizes={IMG.grid.sizes}
            eager={i < 3}
          />
        </a>
      ))}
    </div>

  </section>

</Base>
